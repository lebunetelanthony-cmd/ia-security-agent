{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nightly-llm-config-v1.schema.json",
  "title": "IA Security Agent Nightly LLM Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "enabled",
    "provider",
    "endpoint",
    "provider_version",
    "model",
    "model_digest",
    "authority",
    "input_relative_path",
    "schedule"
  ],
  "properties": {
    "schema": {
      "const": "ia-security-agent-nightly-llm-config-v1"
    },
    "enabled": {
      "type": "boolean"
    },
    "provider": {
      "const": "ollama"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "const": "NON_FACTUAL_CONSUMER"
    },
    "input_relative_path": {
      "type": "string",
      "minLength": 1
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "timezone"
      ],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
