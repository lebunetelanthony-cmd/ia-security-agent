[Unit]
Description=IA Security Agent deterministic security cycle
After=local-fs.target
RequiresMountsFor=@RUNTIME_ROOT@
ConditionPathExists=@INSTANCE_CONFIG@
ConditionPathExists=@RUNTIME_ENTRYPOINT@

[Service]
Type=oneshot

User=@SERVICE_USER@
Group=@SERVICE_GROUP@

WorkingDirectory=@RUNTIME_ROOT@

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=@PYTHON_BIN@ -I -B @RUNTIME_ENTRYPOINT@ --instance-config @INSTANCE_CONFIG@

UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes

ProtectSystem=strict
ProtectHome=read-only

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

RestrictSUIDSGID=yes
LockPersonality=yes

ReadOnlyPaths=@PACKAGE_ROOT@
ReadOnlyPaths=@RUNTIME_ROOT@/config
ReadOnlyPaths=@RUNTIME_ROOT@/baseline

ReadWritePaths=@RUNTIME_ROOT@/history
ReadWritePaths=@RUNTIME_ROOT@/state
ReadWritePaths=@RUNTIME_ROOT@/reports
ReadWritePaths=@RUNTIME_ROOT@/runs
ReadWritePaths=@RUNTIME_ROOT@/attempts
ReadWritePaths=@RUNTIME_ROOT@/failures
ReadWritePaths=@RUNTIME_ROOT@/commits
ReadWritePaths=@RUNTIME_ROOT@/locks

[Install]
WantedBy=multi-user.target
